{
    "name": "winuxio/winux-cli",
    "description": "Simplify local dev ops for Windows/WSL - automates nginx, databases, and environment setup.",
    "keywords": ["wsl", "windows", "laravel", "nginx", "cli", "devops", "local-development"],
    "homepage": "https://winux.io",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "support": {
        "issues": "https://github.com/winuxio/winux-cli/issues",
        "source": "https://github.com/winuxio/winux-cli"
    },
    "authors": [
        {
            "name": "Chris Reed",
            "homepage": "https://github.com/chrisreedio"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel-zero/framework": "^12.0",
        "nunomaduro/termwind": "^2.0",
        "saloonphp/laravel-plugin": "^4.0",
        "saloonphp/saloon": "^4.0",
        "symfony/uid": "^7.0"
    },
    "require-dev": {
        "laravel/pint": "^1.8",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.3.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "bin": ["winux"],
    "scripts": {
        "test": "pest",
        "lint": "pint"
    }
}
